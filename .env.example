# Inputs are read as GitHub Action inputs, exposed to the container as INPUT_*
# environment variables (upper-cased input name). Set these when running the
# container directly, e.g. `docker run --env-file .env githubusermanager`.
INPUT_GOOGLE-EMAIL-ADDRESS=hello@example.com
INPUT_GOOGLE-
INPUT_ADD-USERS=TRUE
INPUT_REMOVE-USERS=TRUE
INPUT_EXIT-CODE-ON-MISMATCH=0
INPUT_GITHUB-ORG=myorg
INPUT_GITHUB-INSTALLATION-ID=123
INPUT_GITHUB-APP-ID=123
INPUT_GITHUB-PRIVATE-KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tXG5wcml2YXRla2V5Z29lc2hlcmVcbi0tLS0tRU5EIFBSSVZBVEUgS0VZLS0tLS1cbg==
INPUT_IGNORED-USERS=user1,user2
INPUT_SYNC-TEAM=TRUE
INPUT_TEAM-SLUG=remarkable
